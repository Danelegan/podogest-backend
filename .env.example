# Copia este archivo como .env y completa los valores (el .env no se sube a git).

# Obligatoria. Genera una con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True solo en desarrollo local. En producción omitir (por defecto False).
DEBUG=True

# Opcional: sin ella se usa db.sqlite3. En Render la define la base de datos PostgreSQL.
# DATABASE_URL=postgres://usuario:clave@host:5432/podogest

# URLs del frontend autorizadas por CORS, separadas por comas.
# FRONTEND_URLS=https://podogest-frontend.vercel.app

# Proxies delante de Django (Render = 1).
# NUM_PROXIES=1

EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
RESEND_API_KEY=

# URL pública del backend, para los enlaces confirmar/cancelar del recordatorio (sin '/' final).
# SITE_URL=https://podogest-backend.onrender.com

# Zona horaria en que se interpretan las horas de las citas (por defecto America/Santiago).
# CLINIC_TIME_ZONE=America/Santiago

# Token secreto para /api/cron/send-reminders/ (lo usa cron-job.org). Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CRON_SECRET=
